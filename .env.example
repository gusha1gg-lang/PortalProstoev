# --- Режимы интеграций (dev без домена / prod в доменной сети) ---
# mock = локальная разработка в WSL без доступа к корпоративным системам
# live = прод на Oracle Linux в доменной сети
INTEGRATION_MODE=mock
AUTH_MODE=dev

# --- Django ---
DJANGO_SECRET_KEY=change-me-in-prod
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Только для прода (через запятую), например: https://portal.company.local
DJANGO_CSRF_TRUSTED_ORIGINS=

# --- App DB (PostgreSQL) ---
POSTGRES_DB=portalprostoev
POSTGRES_USER=portal
POSTGRES_PASSWORD=portal
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# --- Oracle DB (источник простоев, второй уровень) --- [только для INTEGRATION_MODE=live]
ORACLE_USER=
ORACLE_PASSWORD=
ORACLE_DSN=
ORACLE_DOWNTIME_TABLE=DOWNTIMES

# --- OMNITRACKER (ITIL-тикеты) --- [только для INTEGRATION_MODE=live]
OMNITRACKER_BASE_URL=
OMNITRACKER_USER=
OMNITRACKER_PASSWORD=

# --- ADFS --- [только для AUTH_MODE=adfs]
ADFS_SERVER=
ADFS_CLIENT_ID=
ADFS_CLIENT_SECRET=

# --- Уведомления ---
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
TELEGRAM_BOT_TOKEN=
