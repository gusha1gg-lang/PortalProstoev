# --- Режимы интеграций (dev без домена / prod в доменной сети) ---
# mock = локальная разработка в WSL без доступа к корпоративным системам
# live = прод на Oracle Linux в доменной сети
INTEGRATION_MODE=mock
AUTH_MODE=dev

# --- App DB (PostgreSQL) ---
DATABASE_URL="postgresql://portal:portal@localhost:5432/portalprostoev?schema=public"

# --- Oracle DB (источник простоев, второй уровень) --- [только для INTEGRATION_MODE=live]
ORACLE_USER=
ORACLE_PASSWORD=
ORACLE_CONNECT_STRING=

# --- OMNITRACKER (ITIL-тикеты) --- [только для INTEGRATION_MODE=live]
OMNITRACKER_BASE_URL=
OMNITRACKER_USER=
OMNITRACKER_PASSWORD=

# --- ADFS / OIDC --- [только для AUTH_MODE=adfs]
ADFS_ISSUER=
ADFS_CLIENT_ID=
ADFS_CLIENT_SECRET=
ADFS_REDIRECT_URI=

# --- Уведомления ---
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
TELEGRAM_BOT_TOKEN=
