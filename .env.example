# --- Режимы интеграций (dev без домена / prod в доменной сети) ---
# mock = локальная разработка в WSL без доступа к корпоративным системам
# live = прод на Oracle Linux в доменной сети
INTEGRATION_MODE=mock
AUTH_MODE=dev

# --- Django ---
DJANGO_SECRET_KEY=change-me-in-prod
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Только для прода (через запятую), например: https://portal.company.local
DJANGO_CSRF_TRUSTED_ORIGINS=

# --- App DB (PostgreSQL) ---
POSTGRES_DB=portalprostoev
POSTGRES_USER=portal
POSTGRES_PASSWORD=portal
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# --- Oracle DB (источник простоев, второй уровень) --- [только для INTEGRATION_MODE=live]
ORACLE_USER=
ORACLE_PASSWORD=
ORACLE_DSN=
ORACLE_DOWNTIME_TABLE=DOWNTIMES

# --- OMNITRACKER (ITIL-тикеты) --- [только для INTEGRATION_MODE=live]
OMNITRACKER_BASE_URL=
OMNITRACKER_USER=
OMNITRACKER_PASSWORD=

# --- ADFS (корпоративный вход) --- [только для AUTH_MODE=adfs]
# Реквизиты выдаёт ИТ-служба/коллеги из ПИ-ПС (question.md, В25).
ADFS_SERVER=
ADFS_CLIENT_ID=
ADFS_CLIENT_SECRET=
ADFS_TENANT_ID=
ADFS_RELYING_PARTY_ID=
ADFS_USERNAME_CLAIM=winaccountname
ADFS_GROUPS_CLAIM=group

# --- Уведомления (этап 8) ---
# В разработке письма печатаются в консоль (не уходят наружу).
# На проде backend = smtp, реквизиты уточняются у коллег из ПИ-ПС (question.md, В22).
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=portal@localhost
EMAIL_HOST=
EMAIL_PORT=25
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
EMAIL_USE_SSL=False
NOTIFICATION_SLA_WARNING_PERCENT=80
# Telegram пока не используется (только email).
